# Copy to deploy/.env and adjust. Everything left out uses the default from docker-compose.yml.

# Address players open (link and QR code)
PUBLIC_URL=https://voicigame.duckdns.org
# Docker network of the reverse proxy container (docker inspect <proxy> shows it)
PROXY_NETWORK=caddy
# Disk space all rooms together may use; leave room for the other sites (df -h / shows what is free)
MAX_STORAGE_GB=10
# Of that, how much may be kept for packs the server has seen before. A pack in here is never
# uploaded or converted again, so more space here means less work and less traffic.
PACK_CACHE_GB=6
# Memory and CPU for the container
MEM_LIMIT=800m
CPUS=1.0
